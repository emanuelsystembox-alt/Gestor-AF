{
  "manifest_version": 3,
  "name": "AFLINE — ponte com o TOA",
  "description": "Sincronismo do Gestor AF com o TOA: baixa a planilha de Atividades e lê do TOA nome do cliente e equipamentos; lê do Portal Técnico da Claro o sinal antes e depois da visita. Não altera nada no TOA nem no portal.",
  "version": "0.9.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://clarobrasil.fs.ocs.oraclecloud.com/*",
    "https://prd-worker-mangerportal.clarobrasil.mobi/*"
  ],
  "action": {
    "default_title": "AFLINE — ponte com o TOA"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "fundo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pulsoline.grupoafline.com.br/*",
        "https://gestor-af.pages.dev/*",
        "https://*.gestor-af.pages.dev/*",
        "http://localhost:5173/*"
      ],
      "js": [
        "ponte.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://clarobrasil.fs.ocs.oraclecloud.com/*"
      ],
      "js": [
        "toa.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://clarobrasil.fs.ocs.oraclecloud.com/*"
      ],
      "js": [
        "toa-pagina.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://portaltecnico.clarobrasil.mobi/*"
      ],
      "js": [
        "portal-claro.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
