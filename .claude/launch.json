{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "afline-manager",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "app"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "afline-build",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "exec",
        "--",
        "vite",
        "preview",
        "app",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}